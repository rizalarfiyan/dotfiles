# gitignore — dotfiles repo local/machine-specific exclusions

# ---------------------------------------------------------------------------
# Personal identity — NEVER commit
# ---------------------------------------------------------------------------
.gitconfig.local

# ~/.config/git/config contains personal name/email/signing key.
# The tracked version is config.example; the real file must never be committed.
git/.config/git/config

# ---------------------------------------------------------------------------
# Local overrides (any file matching *.local anywhere in the repo)
# ---------------------------------------------------------------------------
*.local

# ---------------------------------------------------------------------------
# Editor noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Installation artifacts
# ---------------------------------------------------------------------------
*.log
install.log
zinit-install.log

# Keep manage.sh/install.sh executable bit info out of diffs
# (git tracks it anyway; no need to ignore)